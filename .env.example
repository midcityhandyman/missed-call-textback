# Everything here is optional. With no .env at all the service runs offline with the mock SMS provider.
PORT=8787
BUSINESS_NAME=Example Home Services
BUSINESS_LINE=+12125550100
DEFAULT_TIME_ZONE=America/New_York

# Quiet hours are local to the caller. A window may wrap past midnight.
QUIET_START=21:00
QUIET_END=08:00

# No double text rule: at most one text per caller inside this window.
COOLDOWN_HOURS=24

# If set, both webhooks (call events and inbound SMS) must carry x-signature: hex HMAC SHA256 of the raw body.
WEBHOOK_SECRET=

# Optional JSON snapshot so idempotency survives a restart.
STATE_FILE=

# "mock" (default, offline) or "http" (generic JSON SMS API).
SMS_PROVIDER=mock
SMS_API_URL=
SMS_API_KEY=
