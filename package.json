{
  "name": "missed-call-textback",
  "version": "0.1.0",
  "private": true,
  "description": "Webhook service that sends exactly one text back after a missed call, with quiet hours, opt outs and idempotency.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "demo": "tsx src/demo.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && node --import tsx --test \"test/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
